[Unit]
Description=Noticiencias admin stack: API, image reconciler/generator and GUI (plan 203)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/carlos/VS_Code_Projects/products/noticiencias/noticiencias_news_collector
Environment=PYTHONUNBUFFERED=1
Environment=PYTHON_BIN=.venv/bin/python
# Fixed ports so the daily publisher finds the API at 127.0.0.1:8000.
Environment=API_PORT=8000
Environment=GUI_PORT=4321
# El servicio manda en 8000/4321: si encuentra un `make admin` manual, lo
# reemplaza en vez de reutilizarlo y quedar inactivo (plan 204).
Environment=ADMIN_STACK_MODE=restart
# Codex (image generation) and gh live in ~/.local/bin; node/npm come from nvm
# (update the version here if nvm switches it).
Environment=PATH=%h/.local/bin:%h/.nvm/versions/node/v24.19.0/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/bash scripts/dev/admin_stack.sh
Restart=on-failure
RestartSec=30
KillMode=control-group
TimeoutStopSec=60
SyslogIdentifier=noticiencias-admin

[Install]
WantedBy=default.target
