# Noticiencias News Collector environment template
# Copy this file to .env and adjust values for your environment.
# Prefixed variables override config.toml.
# Non-prefixed overrides: LOG_LEVEL, HEALTHCHECK_MAX_PENDING, HEALTHCHECK_MAX_INGEST_MINUTES, AUDIT_TODOS_MAX_NEW.

# -----------------------------------------------------------------------------
# Runtime environment
NOTICIENCIAS__APP__ENVIRONMENT=development
NOTICIENCIAS__APP__DEBUG=true
# NOTICIENCIAS__APP__TIMEZONE=UTC

# -----------------------------------------------------------------------------
# Logging
LOG_LEVEL=INFO
# NOTICIENCIAS__LOGGING__LEVEL=INFO

# -----------------------------------------------------------------------------
# Database configuration
NOTICIENCIAS__DATABASE__DRIVER=sqlite
NOTICIENCIAS__DATABASE__PATH=data/news_v3.db
# NOTICIENCIAS__DATABASE__HOST=localhost
# NOTICIENCIAS__DATABASE__PORT=5432
# NOTICIENCIAS__DATABASE__NAME=noticiencias
# NOTICIENCIAS__DATABASE__USER=collector
# NOTICIENCIAS__DATABASE__PASSWORD=change-me
# NOTICIENCIAS__DATABASE__SSLMODE=require
# NOTICIENCIAS__DATABASE__CONNECT_TIMEOUT=10
# NOTICIENCIAS__DATABASE__STATEMENT_TIMEOUT=30000
# NOTICIENCIAS__DATABASE__POOL_SIZE=10
# NOTICIENCIAS__DATABASE__MAX_OVERFLOW=5
# NOTICIENCIAS__DATABASE__POOL_TIMEOUT=30
# NOTICIENCIAS__DATABASE__POOL_RECYCLE=1800

# -----------------------------------------------------------------------------
# Ollama model routing
NOTICIENCIAS__OLLAMA__API_URL=http://localhost:11434/api/generate
NOTICIENCIAS__OLLAMA__MODEL=llama3.3:latest
# NOTICIENCIAS__OLLAMA__TRANSLATOR_MODEL=llama3.2:latest
# NOTICIENCIAS__OLLAMA__EDITOR_MODEL=llama3.3:latest
# NOTICIENCIAS__OLLAMA__HEADLINES_MODEL=llama3.2:latest

# -----------------------------------------------------------------------------
# Gemini model routing
# NOTICIENCIAS__GEMINI__API_KEY=your_google_ai_studio_api_key_here
# NOTICIENCIAS__GEMINI__MODEL=gemini-2.5-flash
# Alternative available model for API stability:
# NOTICIENCIAS__GEMINI__MODEL=gemma-4-31b-it

# -----------------------------------------------------------------------------
# NVIDIA NIM model routing (takes priority over Gemini and Ollama when set)
# Get your key at https://build.nvidia.com/ → your profile → API keys
# Verify the exact model ID at https://build.nvidia.com/models
# NOTICIENCIAS__NVIDIA__API_KEY=nvapi-your_nvidia_api_key_here
# NOTICIENCIAS__NVIDIA__MODEL=qwen/qwen3-next-80b-a3b-thinking
# NOTICIENCIAS__NVIDIA__BASE_URL=https://integrate.api.nvidia.com/v1
# NOTICIENCIAS__NVIDIA__TIMEOUT=300
# NOTICIENCIAS__NVIDIA__MAX_TOKENS=4096

# GitHub publishing token (flat alias -> config.github.token). Required to open PRs.
# GITHUB_TOKEN=ghp_your_token_here
# Optional auditor-specific overrides (legacy compat keys also supported)
# NOTICIENCIAS__EDITORIAL_AUDITOR__TIMEOUT_SECONDS=45
# NOTICIENCIAS__EDITORIAL_AUDITOR__MAX_RETRIES=2
# NOTICIENCIAS__EDITORIAL_AUDITOR__HEALTH_TIMEOUT_SECONDS=2
# OLLAMA_TIMEOUT_SECONDS=45
# OLLAMA_RETRY_ATTEMPTS=2
# OLLAMA_HEALTH_TIMEOUT_SECONDS=2

# Optional preflight for CI/local startup diagnostics (off by default)
# NOTICIENCIAS_OLLAMA_PREFLIGHT=1
# Optional hardening flags (off by default)
NOTICIENCIAS_LLM_PINNED=0
# NOTICIENCIAS_LLM_STRICT=0
# NOTICIENCIAS_LLM_NO_WARN=0

# -----------------------------------------------------------------------------
# Collection pipeline
NOTICIENCIAS__COLLECTION__COLLECTION_INTERVAL_HOURS=6
NOTICIENCIAS__COLLECTION__REQUEST_TIMEOUT_SECONDS=30
NOTICIENCIAS__COLLECTION__ASYNC_ENABLED=false
NOTICIENCIAS__COLLECTION__MAX_CONCURRENT_REQUESTS=1
NOTICIENCIAS__COLLECTION__MAX_ARTICLES_PER_SOURCE=5
NOTICIENCIAS__COLLECTION__RECENT_DAYS_THRESHOLD=365
NOTICIENCIAS__COLLECTION__USER_AGENT=NoticienciasBot/1.0 (+https://noticiencias.com)
# NOTICIENCIAS__COLLECTION__CANONICALIZATION_CACHE_SIZE=2048

# -----------------------------------------------------------------------------
# Rate limiting
NOTICIENCIAS__RATE_LIMITING__DELAY_BETWEEN_REQUESTS_SECONDS=1.0
NOTICIENCIAS__RATE_LIMITING__DOMAIN_DEFAULT_DELAY_SECONDS=1.0
NOTICIENCIAS__RATE_LIMITING__MAX_RETRIES=3
NOTICIENCIAS__RATE_LIMITING__RETRY_DELAY_SECONDS=1.0
NOTICIENCIAS__RATE_LIMITING__BACKOFF_BASE=0.5
NOTICIENCIAS__RATE_LIMITING__BACKOFF_MAX=10.0
NOTICIENCIAS__RATE_LIMITING__JITTER_MAX=0.3
# NOTICIENCIAS__RATE_LIMITING__DOMAIN_OVERRIDES={"export.arxiv.org":20.0,"arxiv.org":20.0}

# -----------------------------------------------------------------------------
# Robots
NOTICIENCIAS__ROBOTS__RESPECT_ROBOTS=true
NOTICIENCIAS__ROBOTS__CACHE_TTL_SECONDS=3600

# -----------------------------------------------------------------------------
# Scoring configuration (weights live in config.toml by default)
NOTICIENCIAS__SCORING__DAILY_TOP_COUNT=10
NOTICIENCIAS__SCORING__MINIMUM_SCORE=0.3
NOTICIENCIAS__SCORING__MODE=cognitive
NOTICIENCIAS__SCORING__WORKERS=1
# NOTICIENCIAS__SCORING__WEIGHTS__SOURCE_CREDIBILITY=0.10
# NOTICIENCIAS__SCORING__WEIGHTS__RECENCY=0.10
# NOTICIENCIAS__SCORING__WEIGHTS__CONTENT_QUALITY=0.10
# NOTICIENCIAS__SCORING__WEIGHTS__ENGAGEMENT_POTENTIAL=0.70
# NOTICIENCIAS__SCORING__FEATURE_WEIGHTS__SOURCE_CREDIBILITY=0.30
# NOTICIENCIAS__SCORING__FEATURE_WEIGHTS__FRESHNESS=0.25
# NOTICIENCIAS__SCORING__FEATURE_WEIGHTS__CONTENT_QUALITY=0.25
# NOTICIENCIAS__SCORING__FEATURE_WEIGHTS__ENGAGEMENT=0.20
NOTICIENCIAS__SCORING__FRESHNESS__HALF_LIFE_HOURS=18.0
NOTICIENCIAS__SCORING__FRESHNESS__MAX_DECAY_HOURS=168.0
NOTICIENCIAS__SCORING__DIVERSITY_PENALTY__WEIGHT=0.15
NOTICIENCIAS__SCORING__DIVERSITY_PENALTY__MAX_PENALTY=0.3
NOTICIENCIAS__SCORING__CONTENT_QUALITY_HEURISTICS__TITLE_LENGTH_DIVISOR=120.0
NOTICIENCIAS__SCORING__CONTENT_QUALITY_HEURISTICS__SUMMARY_LENGTH_DIVISOR=400.0
NOTICIENCIAS__SCORING__CONTENT_QUALITY_HEURISTICS__ENTITY_TARGET_COUNT=5.0
NOTICIENCIAS__SCORING__CONTENT_QUALITY_HEURISTICS__WEIGHTS__TITLE=0.4
NOTICIENCIAS__SCORING__CONTENT_QUALITY_HEURISTICS__WEIGHTS__SUMMARY=0.4
NOTICIENCIAS__SCORING__CONTENT_QUALITY_HEURISTICS__WEIGHTS__ENTITY=0.2
NOTICIENCIAS__SCORING__ENGAGEMENT_HEURISTICS__SENTIMENT_SCORES__POSITIVE=0.7
NOTICIENCIAS__SCORING__ENGAGEMENT_HEURISTICS__SENTIMENT_SCORES__NEGATIVE=0.6
NOTICIENCIAS__SCORING__ENGAGEMENT_HEURISTICS__SENTIMENT_SCORES__NEUTRAL=0.5
NOTICIENCIAS__SCORING__ENGAGEMENT_HEURISTICS__FALLBACK_SENTIMENT=0.5
NOTICIENCIAS__SCORING__ENGAGEMENT_HEURISTICS__WORD_COUNT_DIVISOR=800.0
NOTICIENCIAS__SCORING__ENGAGEMENT_HEURISTICS__EXTERNAL_WEIGHT=0.6
NOTICIENCIAS__SCORING__ENGAGEMENT_HEURISTICS__LENGTH_WEIGHT=0.4
NOTICIENCIAS__SCORING__RERANKER_SEED=1337
NOTICIENCIAS__SCORING__SOURCE_CAP_PERCENTAGE=0.5
NOTICIENCIAS__SCORING__TOPIC_CAP_PERCENTAGE=0.6
# NOTICIENCIAS__SCORING__LLM_MODEL=llama3.2:latest

# -----------------------------------------------------------------------------
# Text processing
NOTICIENCIAS__TEXT_PROCESSING__MIN_CONTENT_LENGTH=100
# NOTICIENCIAS__TEXT_PROCESSING__BOOST_KEYWORDS=["breakthrough","discovery"]
# NOTICIENCIAS__TEXT_PROCESSING__PENALTY_KEYWORDS=["shocking","miracle cure"]

# -----------------------------------------------------------------------------
# Enrichment
NOTICIENCIAS__ENRICHMENT__DEFAULT_MODEL=pattern_v1
NOTICIENCIAS__ENRICHMENT__ANALYSIS_CACHE_SIZE=512
NOTICIENCIAS__ENRICHMENT__RESULT_CACHE_SIZE=256

# -----------------------------------------------------------------------------
# Deduplication
NOTICIENCIAS__DEDUP__SIMHASH_THRESHOLD=10
NOTICIENCIAS__DEDUP__SIMHASH_CANDIDATE_WINDOW=500

# -----------------------------------------------------------------------------
# Reddit API (OAuth2 application-only — required for reddit_science source)
# Register your app at https://www.reddit.com/prefs/apps (script type)
# REDDIT_CLIENT_ID=your_client_id_here
# REDDIT_CLIENT_SECRET=your_client_secret_here

# -----------------------------------------------------------------------------
# Operational scripts
HEALTHCHECK_MAX_PENDING=250
HEALTHCHECK_MAX_INGEST_MINUTES=180
AUDIT_TODOS_MAX_NEW=0
