---
import AuthGate from "../components/AuthGate.astro";
import AdminLayout from "../layouts/AdminLayout.astro";
---

<AdminLayout title="Prompts" current="/prompts">
  <AuthGate>
    <header class="mb-8 flex items-end justify-between">
      <div>
        <h1 class="display-title text-4xl text-paper-100">Prompt lab</h1>
        <p class="data-label mt-2">EDIT SYSTEM PROMPTS · config/prompts.yaml</p>
      </div>
      <button id="save" class="btn-primary" type="button">Save prompts</button>
    </header>
    <div id="prompts" class="grid grid-cols-1 gap-6">
      <div class="py-16 text-center font-mono text-sm text-ink-400">
        Loading…
      </div>
    </div>
    <div id="toast" class="fixed bottom-6 right-6 z-50 hidden max-w-sm rounded-lg border border-ink-600 bg-ink-900 px-4 py-3 text-sm shadow-xl"></div>
  </AuthGate>
</AdminLayout>

<script>
  import { clearToken, getPrompts, savePrompts, showAuthGate } from "../lib/api";

  const root = document.getElementById("prompts");
  const toastEl = document.getElementById("toast");
  const saveBtn = document.getElementById("save");



  function esc(s: unknown): string {
    if (s == null) return "";
    const div = document.createElement("div");
    div.textContent = String(s);
    return div.innerHTML;
  }

  function showToast(message: string, kind: "ok" | "err" = "ok") {
    if (!toastEl) return;
    toastEl.textContent = message;
    toastEl.className =
      `fixed bottom-6 right-6 z-50 max-w-sm rounded-lg border px-4 py-3 text-sm shadow-xl ` +
      (kind === "ok"
        ? "border-verdigris-500/50 bg-ink-900 text-verdigris-400"
        : "border-rose-500/50 bg-ink-900 text-rose-400");
    toastEl.classList.remove("hidden");
    window.setTimeout(() => toastEl?.classList.add("hidden"), 2600);
  }

  async function load() {
    try {
      const { prompts } = await getPrompts();

      if (!root) return;
      const keys = Object.keys(prompts).sort();
      if (!keys.length) {
        root.innerHTML = `<div class="card p-8 text-center text-sm text-ink-400">No prompts.yaml found — add prompts and save.</div>`;
        return;
      }
      root.innerHTML = keys
        .map(
          (key) => `
          <div class="card p-5">
            <div class="mb-3 flex items-center justify-between">
              <div class="data-label">${esc(key)}</div>
              <span class="font-mono text-[11px] text-ink-400">${Object.keys(prompts[key] ?? {}).length} field(s)</span>
            </div>
            ${Object.entries(prompts[key] ?? {})
              .map(
                ([field, value]) => `
                <label class="mb-3 block">
                  <span class="data-label block mb-1.5">${esc(field)}</span>
                  <textarea data-key="${esc(key)}" data-field="${esc(field)}" rows="6"
                    class="w-full rounded-lg border border-ink-700 bg-ink-900 px-4 py-3 font-mono text-xs leading-relaxed text-ink-100 outline-none transition-colors focus:border-amber-500">${esc(value)}</textarea>
                </label>`,
              )
              .join("")}
          </div>`,
        )
        .join("");
    } catch (e) {
      if (e instanceof Error && e.name === "AuthError") {
        clearToken();
        showAuthGate();
        return;
      }
      showToast("Failed to load prompts: " + (e as Error).message, "err");
    }
  }

  saveBtn?.addEventListener("click", async () => {
    const textareas = document.querySelectorAll<HTMLTextAreaElement>(
      "#prompts textarea[data-key]",
    );
    const updated: Record<string, Record<string, unknown>> = {};
    textareas.forEach((ta) => {
      const key = ta.dataset.key ?? "";
      const field = ta.dataset.field ?? "";
      if (!key || !field) return;
      updated[key] = { ...(updated[key] ?? {}), [field]: ta.value };
    });
    try {
      await savePrompts(updated);

      showToast("Prompts saved to config/prompts.yaml");
    } catch (e) {
      if (e instanceof Error && e.name === "AuthError") {
        clearToken();
        showAuthGate();
        return;
      }
      showToast("Save failed: " + (e as Error).message, "err");
    }
  });

  void load();
  window.addEventListener("auth:ready", () => void load());
</script>
