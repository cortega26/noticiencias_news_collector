---
import AuthGate from "../components/AuthGate.astro";
import AdminLayout from "../layouts/AdminLayout.astro";
---

<AdminLayout title="Triage" current="/triage">
  <AuthGate>
    <header class="mb-8 flex items-end justify-between gap-4">
      <div>
        <h1 class="display-title text-4xl text-paper-100">Curaduría</h1>
        <p class="data-label mt-2">TECLADO PRIMERO · J/K NAVEGAR · P PUBLICAR · R RECHAZAR · A/F AUDITORÍA · O ABRIR</p>
      </div>
      <div class="flex items-center gap-3">
        <label class="flex cursor-pointer items-center gap-2 font-mono text-xs text-ink-300">
          <input id="dry-run" type="checkbox" class="accent-amber-500" />
          simulación
        </label>
        <button id="collect-btn" class="btn-primary" type="button">
          Buscar noticias
        </button>
        <button id="logout-btn" class="btn-ghost" type="button">Salir</button>
      </div>
    </header>

    <form id="publish-url-form" class="mb-4 flex items-center gap-2">
      <input
        id="publish-url"
        type="url"
        placeholder="Pega un enlace para publicarlo"
        class="flex-1 rounded-lg border border-ink-700 bg-ink-900 px-3.5 py-2 font-mono text-xs text-ink-100 outline-none transition-colors placeholder:text-ink-600 focus:border-amber-500"
      />
      <button id="publish-url-btn" class="btn-ghost whitespace-nowrap" type="submit">
        Publicar
      </button>
    </form>

    <div id="collect-status" role="status" aria-live="polite" class="mb-6 hidden rounded-lg border border-ink-700 bg-ink-850/60 px-4 py-2.5 font-mono text-xs text-ink-200"></div>
    <div id="publish-status" role="status" aria-live="polite" class="mb-6 hidden rounded-lg border border-ink-700 bg-ink-850/60 px-4 py-2.5 font-mono text-xs text-ink-200"></div>

    <div id="status-filter" class="mb-6 flex flex-wrap gap-2"></div>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]">
      <!-- queue -->
      <section class="card p-4">
        <div class="mb-3 flex items-center justify-between">
          <div class="data-label">QUEUE</div>
          <div id="queue-count" class="font-mono text-xs text-ink-400">—</div>
        </div>
        <div class="mb-3 flex items-center justify-between gap-2">
          <button id="batch-publish-btn" class="btn-ghost whitespace-nowrap" type="button" disabled>
            Publicar selección (<span id="batch-count">0</span>/5)
          </button>
          <span class="font-mono text-[11px] text-ink-500">marca filas publicables · de una en una</span>
        </div>
        <div id="queue" class="max-h-[68vh] space-y-2 overflow-y-auto pr-1"></div>
        <button id="load-more" class="btn-ghost mt-4 hidden w-full justify-center" type="button">
          Cargar más
        </button>
        <div id="queue-empty" class="hidden py-10 text-center text-sm text-ink-400">
          Cola vacía. Busca noticias nuevas o pega un enlace arriba.
        </div>
      </section>

      <!-- detail -->
      <section class="card min-h-[68vh] p-6">
        <div id="detail-empty" class="flex h-full flex-col items-center justify-center py-16 text-center">
          <div class="display-title text-2xl text-ink-400">Ningún artículo seleccionado</div>
          <p class="mt-2 max-w-sm text-sm text-ink-400">
            Navega la cola con <span class="kbd">j</span> /
            <span class="kbd">k</span> o pulsa una tarjeta para verla.
          </p>
        </div>
        <div id="detail" class="hidden"></div>
        <div id="toast" role="status" class="fixed bottom-6 right-6 z-50 hidden max-w-sm rounded-lg border border-ink-600 bg-ink-900 px-4 py-3 text-sm shadow-xl"></div>
      </section>
    </div>
  </AuthGate>
</AdminLayout>

<style>
  @reference "../styles/global.css";

  .queue-item {
    @apply space-y-1.5;
  }
  .queue-card {
    @apply w-full cursor-pointer rounded-lg border border-ink-700 bg-ink-900/60 p-3.5 text-left transition-all;
  }
  .queue-card:hover {
    @apply border-ink-600 bg-ink-800/70;
  }
  .queue-card.active {
    @apply border-amber-500/70 bg-ink-800;
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--color-amber-500) 40%, transparent);
  }
  .btn-primary:disabled {
    cursor: not-allowed;
    opacity: 0.45;
  }
  .score-chip {
    @apply font-mono text-xs font-semibold text-amber-400;
  }
</style>

<script>
  import {
    ConflictError,
    NetworkError,
    clearToken,
    getArticle,
    getCollectStatus,
    getPublishStatus,
    listArticles,
    rejectArticle,
    reprocessArticle,
    showAuthGate,
    startCollect,
    startPublish,
    startPublishBatch,
    updateAuditStatus,
  } from "../lib/api";
  import type {
    AdminCollectStarted,
    AdminPublishBatchItem,
    AdminPublishStarted,
  } from "../lib/types";
  import type {
    AdminArticleDetail,
    AdminArticleListItem,
    ArticleStatus,
  } from "../lib/types";

  const STATUSES: ArticleStatus[] = [
    "publishable",
    "pending",
    "publishing",
    "rejected",
    "completed",
  ];

  /** Operator labels for pipeline statuses (values stay API-contract). */
  const STATUS_LABEL: Record<string, string> = {
    publishable: "Listos",
    pending: "Pendientes",
    publishing: "Publicando",
    rejected: "Rechazados",
    completed: "Completados",
    new: "Nuevo",
  };

  let status: ArticleStatus = "publishable";
  let items: AdminArticleListItem[] = [];
  let selectedId: number | null = null;
  let detail: AdminArticleDetail | null = null;
  let cursor: string | null = null;
  let loading = false;
  // Batch selection (plan 109): ticked publishable row ids. Survives
  // re-renders via renderBatchBar; cleared on filter change with the queue.
  const BATCH_MAX = 5;
  const batchSelected = new Set<number>();

  const queueEl = document.getElementById("queue");
  const detailEl = document.getElementById("detail");
  const detailEmptyEl = document.getElementById("detail-empty");
  const queueEmptyEl = document.getElementById("queue-empty");
  const loadMoreBtn = document.getElementById("load-more");
  const countEl = document.getElementById("queue-count");
  const filterEl = document.getElementById("status-filter");
  const toastEl = document.getElementById("toast");
  const batchBtn = document.getElementById("batch-publish-btn") as HTMLButtonElement | null;
  const batchCountEl = document.getElementById("batch-count");

  /** Publishable ids currently ticked AND still loaded (stale ticks drop). */
  function batchIds(): number[] {
    const loaded = new Set(
      items.filter((i) => i.publishable).map((i) => i.id),
    );
    return [...batchSelected].filter((id) => loaded.has(id)).slice(0, BATCH_MAX);
  }

  function renderBatchBar() {
    const n = batchIds().length;
    if (batchCountEl) batchCountEl.textContent = String(n);
    batchBtn?.toggleAttribute("disabled", publishInFlight || n === 0);
  }

  function esc(s: string | null | undefined): string {
    if (s == null) return "";
    const div = document.createElement("div");
    div.textContent = String(s);
    return div.innerHTML;
  }

  function statusPillClass(s: string | null | undefined): string {
    return `status-pill status-${esc(s ?? "new")}`;
  }

  function statusLabel(s: string | null | undefined): string {
    const key = esc(s ?? "new");
    return STATUS_LABEL[key] ?? key;
  }

  /** Why the publish affordance is disabled for this row, if it is. */
  function notPublishableReason(
    item: Pick<AdminArticleListItem, "processing_status" | "published_url">,
  ): string {
    if (item.processing_status === "publishing") {
      return "En curso — ya hay una publicación abierta para este artículo";
    }
    if (item.published_url) {
      return "Ya publicado — verás la URL en el panel de detalle";
    }
    return "Fuera de la lista actual — busca noticias nuevas o usa Publicar desde URL";
  }

  function showToast(message: string, kind: "ok" | "err" = "ok") {
    if (!toastEl) return;
    toastEl.textContent = message;
    toastEl.className =
      `fixed bottom-6 right-6 z-50 max-w-sm rounded-lg border px-4 py-3 text-sm shadow-xl ` +
      (kind === "ok"
        ? "border-verdigris-500/50 bg-ink-900 text-verdigris-400"
        : "border-rose-500/50 bg-ink-900 text-rose-400");
    toastEl.classList.remove("hidden");
    window.clearTimeout((toastEl as HTMLElement & { _t?: number })._t);
    (toastEl as HTMLElement & { _t?: number })._t = window.setTimeout(
      () => toastEl?.classList.add("hidden"),
      2600,
    );
  }

  function renderFilters() {
    if (!filterEl) return;
    filterEl.innerHTML = "";
    for (const s of STATUSES) {
      const btn = document.createElement("button");
      btn.type = "button";
      btn.textContent = STATUS_LABEL[s] ?? s;
      btn.className =
        "rounded-full border px-3.5 py-1.5 font-mono text-xs uppercase tracking-wider transition-colors " +
        (s === status
          ? "border-amber-500/70 bg-amber-500/10 text-amber-400"
          : "border-ink-700 text-ink-300 hover:border-ink-600 hover:text-ink-100");
      btn.addEventListener("click", () => {
        status = s;
        cursor = null;
        items = [];
        selectedId = null;
        detail = null;
        batchSelected.clear();
        renderFilters();
        void loadQueue();
  window.addEventListener("auth:ready", () => void loadQueue());
      });
      filterEl.appendChild(btn);
    }
  }

  async function loadQueue() {
    if (loading) return;
    loading = true;
    try {
      const envelope = await listArticles(status, cursor, 20);
      items = [...items, ...envelope.data];
      cursor = envelope.pagination.next_cursor;
      renderQueue();
      loadMoreBtn?.classList.toggle("hidden", !envelope.pagination.has_more);
      if (items.length > 0 && selectedId == null) {
        select(items[0].id);
      }
    } catch (e) {
      if (e instanceof Error && e.name === "AuthError") {
        clearToken();
        showAuthGate();
      } else {
        showToast("No se pudo cargar la cola: " + (e as Error).message, "err");
      }
    } finally {
      loading = false;
    }
  }

  function renderQueue() {
    if (!queueEl || !countEl || !queueEmptyEl) return;
    queueEmptyEl.classList.toggle("hidden", items.length > 0);
    countEl.textContent = `${items.length}${cursor ? "+" : ""} · ${STATUS_LABEL[status] ?? status}`;
    queueEl.innerHTML = "";
    items.forEach((item, index) => {
      const wrap = document.createElement("div");
      wrap.className = "queue-item";
      // Batch tick (plan 109): only publishable rows are tickable.
      if (item.publishable) {
        const tick = document.createElement("label");
        tick.className = "flex cursor-pointer items-center gap-2 font-mono text-[11px] text-ink-400";
        const box = document.createElement("input");
        box.type = "checkbox";
        box.className = "batch-tick accent-amber-500";
        box.checked = batchSelected.has(item.id);
        box.disabled = publishInFlight;
        box.setAttribute("aria-label", `Seleccionar el artículo ${item.id} para el lote`);
        box.addEventListener("click", (event) => event.stopPropagation());
        box.addEventListener("change", () => {
          if (box.checked) {
            if (batchSelected.size >= BATCH_MAX && !batchSelected.has(item.id)) {
              box.checked = false;
              showToast(`El lote admite ${BATCH_MAX} artículos como máximo.`, "err");
              return;
            }
            batchSelected.add(item.id);
          } else {
            batchSelected.delete(item.id);
          }
          renderBatchBar();
        });
        const cap = document.createElement("span");
        cap.textContent = "lote";
        tick.append(box, cap);
        wrap.appendChild(tick);
      }
      const card = document.createElement("button");
      card.type = "button";
      card.className = "queue-card" + (item.id === selectedId ? " active" : "");
      card.innerHTML = `
        <div class="mb-1.5 flex items-center justify-between gap-2">
          <span class="${statusPillClass(item.processing_status)}">${statusLabel(item.processing_status)}</span>
          <span class="score-chip" title="${item.publishable ? "Sobre la línea de publicación" : "Bajo la línea de publicación"}">${item.final_score != null ? item.final_score.toFixed(3) : "—"}</span>
        </div>
        ${item.similar_group_id ? `<div class="mb-1.5"><span class="rounded bg-indigo-900/50 px-1.5 py-0.5 font-mono text-[11px] text-indigo-300" title="Grupo de casi-duplicados ${esc(item.similar_group_id)} — conserva el mejor, publica uno">≈ similares ×${item.similar_group_size ?? "?"}</span></div>` : ""}
        <div class="font-display text-[15px] leading-snug text-ink-100">${esc(item.title)}</div>
        <div class="mt-1.5 flex items-center gap-2 font-mono text-[11px] text-ink-400">
          <span>${esc(item.source.name)}</span>
          <span>·</span>
          <span>${esc(item.category ?? "sin categoría")}</span>
          ${item.refinery_id ? `<span>·</span><span>${esc(item.refinery_id)}</span>` : ""}
        </div>
        ${(item.why_ranked ?? []).length ? `<div class="mt-2 flex flex-wrap gap-1">
          ${(item.why_ranked ?? []).slice(0, 2).map((w) => `<span class="rounded bg-ink-800 px-1.5 py-0.5 text-[11px] text-ink-300">${esc(w)}</span>`).join("")}
          ${(item.why_ranked ?? []).length > 2 ? `<details class="inline"><summary class="cursor-pointer rounded bg-ink-800 px-1.5 py-0.5 text-[11px] text-ink-400 hover:text-ink-200">+${(item.why_ranked ?? []).length - 2} más</summary><span class="contents">${(item.why_ranked ?? []).slice(2).map((w) => `<span class="rounded bg-ink-800 px-1.5 py-0.5 text-[11px] text-ink-300">${esc(w)}</span>`).join("")}</span></details>` : ""}
        </div>` : ""}
      `;
      card.addEventListener("click", () => {
        select(item.id);
        const el = queueEl.querySelector(`[data-id="${item.id}"]`);
        void el;
      });
      card.setAttribute("data-id", String(item.id));
      card.setAttribute("data-index", String(index));
      wrap.appendChild(card);

      queueEl.appendChild(wrap);
    });
    queueEl.querySelector(`[data-id="${selectedId}"]`)?.classList.add("active");
    scrollSelectedIntoView();
    renderBatchBar();
  }

  function scrollSelectedIntoView() {
    if (!queueEl) return;
    const el = queueEl.querySelector(`[data-id="${selectedId}"]`);
    el?.scrollIntoView({ block: "nearest" });
  }

  async function select(id: number) {
    selectedId = id;
    renderQueue();
    try {
      detail = await getArticle(id);
      renderDetail();
    } catch (e) {
      if (e instanceof Error && e.name === "AuthError") {
        clearToken();
        showAuthGate();
        return;
      }
      showToast("No se pudo cargar el artículo: " + (e as Error).message, "err");
    }
  }

  function componentBreakdown(): Array<[string, number]> {
    const comps = detail?.score_components;
    if (!comps) return [];
    return Object.entries(comps)
      .filter(([, v]) => v != null && Number.isFinite(v))
      .map(([k, v]) => [k, Number(v)] as [string, number])
      .sort((a, b) => b[1] - a[1]);
  }

  function renderDetail() {
    if (!detailEl || !detailEmptyEl || !detail) return;
    detailEmptyEl.classList.add("hidden");
    detailEl.classList.remove("hidden");
    const comps = componentBreakdown();
    const audit = detail.audit as Record<string, unknown> | undefined;
    const publication = detail.publication as Record<string, unknown> | undefined;

    detailEl.innerHTML = `
      <div class="mb-4 flex items-start justify-between gap-4">
        <div>
          <span class="${statusPillClass(detail.processing_status)}">${statusLabel(detail.processing_status)}</span>
          <span class="ml-2 font-mono text-xs text-ink-400">#${detail.id}</span>
        </div>
        <div class="flex flex-wrap items-center justify-end gap-2">
          <button class="btn-primary" data-action="publish" type="button">Publicar <span class="kbd">P</span></button>
          <button class="btn-ghost" data-action="open" type="button">Abrir original</button>
          <button class="btn-ghost" data-action="full" type="button">Vista completa</button>
          <details class="relative">
            <summary class="btn-ghost cursor-pointer list-none">···</summary>
            <div class="absolute right-0 z-10 mt-1 w-44 card p-1">
              <button class="block w-full rounded-md px-3 py-2 text-left text-sm text-ink-200 hover:bg-ink-800" data-action="reprocess" type="button">Reprocesar</button>
            </div>
          </details>
          <div class="flex overflow-hidden rounded-lg border border-ink-700" role="group" aria-label="Auditoría">
            <button class="px-3 py-2 text-sm font-medium text-ink-300 hover:bg-ink-800 hover:text-ink-100" data-action="audit-pass" type="button">Aprobar <span class="kbd">A</span></button>
            <span class="w-px bg-ink-700" aria-hidden="true"></span>
            <button class="px-3 py-2 text-sm font-medium text-ink-300 hover:bg-ink-800 hover:text-ink-100" data-action="audit-fail" type="button">Suspender <span class="kbd">F</span></button>
          </div>
          <button class="px-2 py-2 text-sm font-medium text-rose-400/80 underline-offset-4 hover:text-rose-400 hover:underline" data-action="reject" type="button">Rechazar <span class="kbd">R</span></button>
        </div>
      </div>
      ${detail.publishable ? "" : `<p class="mb-4 font-mono text-xs text-ink-400">No publicable: ${esc(notPublishableReason(detail))}</p>`}

      <h2 class="display-title text-3xl leading-tight text-paper-100">${esc(detail.title)}</h2>
      <div class="mt-2 font-mono text-xs text-ink-400">
        ${esc(detail.source.name)} · ${esc(detail.category ?? "—")} · recopilado ${esc(detail.collected_at ?? "—")}
      </div>

      ${detail.summary ? `<p class="mt-4 text-[15px] leading-relaxed text-ink-200">${esc(detail.summary)}</p>` : ""}

      <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div class="card p-4">
          <div class="data-label mb-3">PUNTUACIÓN</div>
          <div class="mb-3 flex items-baseline gap-2">
            <span class="font-mono text-4xl font-bold text-amber-400">${detail.final_score != null ? detail.final_score.toFixed(3) : "—"}</span>
            <span class="text-xs text-ink-400">/ 1.0</span>
          </div>
          <p class="mb-3 font-mono text-[11px] text-ink-400">${detail.publishable ? "Sobre la línea de publicación" : "Bajo la línea de publicación"}</p>
          <div class="space-y-2">
            ${comps.map(([k, v]) => `
              <div>
                <div class="mb-1 flex justify-between font-mono text-[11px] text-ink-400">
                  <span>${esc(k)}</span><span>${v.toFixed(3)}</span>
                </div>
                <div class="h-1.5 overflow-hidden rounded-full bg-ink-800">
                  <div class="h-full rounded-full bg-amber-500/80" style="width:${Math.min(100, v * 100)}%"></div>
                </div>
              </div>
            `).join("")}
          </div>
          ${detail.latest_score != null ? `<div class="mt-3 font-mono text-[11px] text-ink-400">ScoreLog más reciente: ${detail.latest_score.toFixed(3)}</div>` : ""}
        </div>

        <div class="space-y-4">
          <div class="card p-4">
            <div class="data-label mb-2">POR QUÉ DESTACA</div>
            ${(detail.why_ranked ?? []).length ? `<ul class="space-y-1.5 text-sm text-ink-200">${detail.why_ranked.map((w) => `<li class="flex gap-2"><span class="text-amber-400">▸</span>${esc(w)}</li>`).join("")}</ul>` : `<p class="text-sm text-ink-400">Sin motivos registrados.</p>`}
          </div>
          <div class="card p-4">
            <div class="data-label mb-2">ESTADO</div>
            <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1.5 font-mono text-xs">
              <dt class="text-ink-400">publicación</dt><dd class="text-ink-200">${esc((publication?.state as string) ?? "—")}</dd>
              <dt class="text-ink-400">id de refinería</dt><dd class="text-ink-200">${esc(detail.refinery_id ?? "—")}</dd>
              <dt class="text-ink-400">auditoría</dt><dd class="text-ink-200">${esc((audit?.state as string) ?? "—")}</dd>
              <dt class="text-ink-400">temas</dt><dd class="text-ink-200">${esc(detail.topics.join(", ") || "—")}</dd>
            </dl>
          </div>
        </div>
      </div>

      ${detail.content ? `
        <div class="card mt-4 p-5">
          <div class="data-label mb-3">CONTENIDO</div>
          <div class="max-h-96 overflow-y-auto whitespace-pre-wrap text-[14px] leading-relaxed text-ink-200">${esc(detail.content)}</div>
        </div>
      ` : ""}
    `;

    detailEl.querySelector('[data-action="open"]')?.addEventListener("click", () => {
      window.open(detail?.url, "_blank", "noopener");
    });
    {
      const publishBtn = detailEl.querySelector(
        '[data-action="publish"]',
      ) as HTMLButtonElement | null;
      const current = detail;
      if (publishBtn && current) {
        if (current.publishable) {
          publishBtn.dataset.armed = "1";
          publishBtn.title = "Publicar este artículo y abrir el PR";
          publishBtn.toggleAttribute("disabled", publishInFlight);
          publishBtn.addEventListener("click", () => {
            void doPublish({ articleId: current.id });
          });
        } else {
          publishBtn.toggleAttribute("disabled", true);
          publishBtn.title = notPublishableReason(current);
        }
      }
    }
    detailEl.querySelector('[data-action="full"]')?.addEventListener("click", () => {
      if (detail) window.location.href = `/article?id=${detail.id}`;
    });
    detailEl.querySelector('[data-action="reprocess"]')?.addEventListener("click", () => {
      void doReprocess();
    });
    detailEl.querySelector('[data-action="reject"]')?.addEventListener("click", () => {
      if (!window.confirm("¿Rechazar este artículo?")) return;
      void doReject();
    });
    detailEl.querySelector('[data-action="audit-pass"]')?.addEventListener("click", () => {
      void doAudit("passed");
    });
    detailEl.querySelector('[data-action="audit-fail"]')?.addEventListener("click", () => {
      void doAudit("failed");
    });
  }

  async function doReprocess() {
    if (detail == null) return;
    try {
      const result = await reprocessArticle(detail.id);
      showToast(result.detail);
      if (result.status === "ok") {
        detail.processing_status = "pending";
        detail.error_message = null;
        renderDetail();
      }
    } catch (e) {
      showToast("No se pudo reprocesar: " + (e as Error).message, "err");
    }
  }

  async function doReject() {
    if (detail == null) return;
    try {
      const result = await rejectArticle(detail.id);
      showToast(result.detail);
      if (result.status === "ok") {
        detail.processing_status = "rejected";
        renderDetail();
      }
    } catch (e) {
      showToast("No se pudo rechazar: " + (e as Error).message, "err");
    }
  }

  async function doAudit(state: string) {
    if (detail == null) return;
    try {
      const result = await updateAuditStatus(detail.id, state);
      showToast(result.detail);
      if (result.status === "ok") {
        detail.audit = { ...(detail.audit as object), state };
        renderDetail();
      }
    } catch (e) {
      showToast("No se pudo auditar: " + (e as Error).message, "err");
    }
  }

  function selectedIndex(): number {
    return items.findIndex((i) => i.id === selectedId);
  }

  function move(delta: number) {
    const idx = selectedIndex();
    const next = items[idx + delta];
    if (next) void select(next.id);
  }

  document.addEventListener("keydown", (event) => {
    if (event.target instanceof HTMLInputElement || event.target instanceof HTMLTextAreaElement) {
      return;
    }
    if (event.key === "Escape") {
      selectedId = null;
      detail = null;
      renderQueue();
      detailEl?.classList.add("hidden");
      detailEmptyEl?.classList.remove("hidden");
      return;
    }
    switch (event.key.toLowerCase()) {
      case "j":
        move(1);
        break;
      case "k":
        move(-1);
        break;
      case "r":
        event.preventDefault();
        void doReject();
        break;
      case "a":
        event.preventDefault();
        void doAudit("passed");
        break;
      case "f":
        event.preventDefault();
        void doAudit("failed");
        break;
      case "o":
        event.preventDefault();
        if (detail?.url) window.open(detail.url, "_blank", "noopener");
        break;
      case "p": {
        event.preventDefault();
        if (detail == null) break;
        if (detail.publishable) {
          void doPublish({ articleId: detail.id });
        } else {
          showToast(notPublishableReason(detail), "err");
        }
        break;
      }
    }
  });

  loadMoreBtn?.addEventListener("click", () => void loadQueue());
  document.getElementById("logout-btn")?.addEventListener("click", () => {
    clearToken();
    window.location.href = "/triage";
  });

  // ------------------------------------------------------------------
  // Fetch fresh news (Phase 3): start a collection run, poll status,
  // refresh the queue when it completes.
  // ------------------------------------------------------------------

  const collectBtn = document.getElementById("collect-btn");
  const collectStatusEl = document.getElementById("collect-status");
  const dryRunInput = document.getElementById("dry-run") as HTMLInputElement | null;
  let pollTimer: number | undefined;

  function renderCollectStatus(text: string) {
    if (!collectStatusEl) return;
    collectStatusEl.textContent = text;
    collectStatusEl.classList.remove("hidden");
  }

  async function pollCollect(runId: string) {
    window.clearInterval(pollTimer);
    // A collection run writes files; with `uvicorn --reload` that can bounce
    // the API for a second or two. Tolerate a few transient failures instead
    // of abandoning a run that is still going.
    let transientFailures = 0;
    const MAX_TRANSIENT = 5;
    pollTimer = window.setInterval(async () => {
      try {
        const st = await getCollectStatus(runId);
        transientFailures = 0;
        if (st.status === "running" || st.status === "queued") {
          renderCollectStatus(`Recopilando… (${runId}) — inicio ${st.started_at ?? "ahora"}`);
          return;
        }
        window.clearInterval(pollTimer);
        if (st.status === "succeeded") {
          const processed =
            (st.summary?.collection_summary as Record<string, unknown> | undefined)
              ?.sources_processed ?? "?";
          renderCollectStatus(`Recopilación terminada: ${processed} fuentes procesadas. Actualizando la cola…`);
          setTimeout(() => {
            collectStatusEl?.classList.add("hidden");
            status = "pending";
            cursor = null;
            items = [];
            void loadQueue();
          }, 1200);
        } else if (st.status === "cancelled") {
          renderCollectStatus(`Recopilación cancelada${st.error ? `: ${st.error}` : "."}`);
        } else if (st.status === "interrupted") {
          renderCollectStatus(
            `Recopilación interrumpida (el servidor se reinició)${st.error ? `: ${st.error}` : "."}`,
          );
        } else {
          renderCollectStatus(`Falló la recopilación: ${st.error ?? "error desconocido"}`);
        }
      } catch (e) {
        if (e instanceof Error && e.name === "AuthError") {
          window.clearInterval(pollTimer);
          clearToken();
          showAuthGate();
          return;
        }
        if (e instanceof NetworkError && transientFailures < MAX_TRANSIENT) {
          transientFailures += 1;
          renderCollectStatus(
            `Recopilando… (${runId}) — API fuera de alcance, reintentando (${transientFailures}/${MAX_TRANSIENT})`,
          );
          return;
        }
        window.clearInterval(pollTimer);
        renderCollectStatus(`Falló la consulta de estado: ${(e as Error).message}`);
      }
    }, 2000);
  }

  collectBtn?.addEventListener("click", async () => {
    collectBtn.setAttribute("disabled", "true");
    try {
      const started = await startCollect(dryRunInput?.checked ?? false);
      renderCollectStatus(
        started.detail + ` (${started.run_id}) — actualizando la cola al terminar.`,
      );
      await pollCollect(started.run_id);
    } catch (e) {
      if (e instanceof Error && e.name === "AuthError") {
        clearToken();
        showAuthGate();
        return;
      }
      if (e instanceof ConflictError) {
        const existing = e.body as Partial<AdminCollectStarted>;
        if (existing.run_id) {
          renderCollectStatus(
            `Ya hay una recopilación en curso (${existing.run_id}) — observándola.`,
          );
          await pollCollect(existing.run_id);
          return;
        }
      }
      renderCollectStatus("No se pudo iniciar la recopilación: " + (e as Error).message);
    } finally {
      collectBtn.removeAttribute("disabled");
    }
  });

  // ------------------------------------------------------------------
  // Refine & Publish (Phase 4c): start one Refinery run for a candidate
  // article (by id, must be publishable) or a pasted URL, poll status,
  // surface the PR link or the editorial-rejection reason.
  // ------------------------------------------------------------------

  const publishStatusEl = document.getElementById("publish-status");
  const publishUrlForm = document.getElementById("publish-url-form") as HTMLFormElement | null;
  const publishUrlInput = document.getElementById("publish-url") as HTMLInputElement | null;
  const publishUrlBtn = document.getElementById("publish-url-btn");
  let publishPollTimer: number | undefined;
  let publishInFlight = false;

  function renderPublishStatus(html: string) {
    if (!publishStatusEl) return;
    publishStatusEl.innerHTML = html;
    publishStatusEl.classList.remove("hidden");
  }

  function setPublishInFlight(active: boolean) {
    publishInFlight = active;
    publishUrlBtn?.toggleAttribute("disabled", active);
    batchBtn?.toggleAttribute("disabled", active || batchIds().length === 0);
    // Only the armed detail publish button is toggled: the queue publishes
    // from the batch bar and the P hotkey.
    document
      .querySelectorAll('#detail [data-action="publish"][data-armed]')
      .forEach((btn) => btn.toggleAttribute("disabled", active));
    document
      .querySelectorAll('.batch-tick')
      .forEach((btn) => btn.toggleAttribute("disabled", active));
  }

  /** Render a batch run's per-item outcomes (plan 109) into the status box. */
  function renderBatchItems(runId: string, items: unknown): boolean {
    if (!Array.isArray(items) || items.length === 0) return false;
    const lines = (items as Partial<AdminPublishBatchItem>[]).map((item) => {
      const id = esc(String(item.article_id ?? "?"));
      if (item.status === "succeeded" && item.pr_url) {
        return `#${id} ✓ <a class="text-amber-400 underline" href="${esc(item.pr_url)}" target="_blank" rel="noopener">${esc(item.pr_url)}</a>`;
      }
      const reason = esc(item.failure_class ?? item.message ?? "unknown error");
      return `#${id} ✗ ${reason}`;
    });
    renderPublishStatus(
      `Lote ${esc(runId)} terminado:<br>${lines.join("<br>")} <span class="text-ink-500">(actualizando la cola…)</span>`,
    );
    return true;
  }

  function scheduleQueueRefresh() {
    setTimeout(() => {
      publishStatusEl?.classList.add("hidden");
      status = "pending";
      cursor = null;
      items = [];
      selectedId = null;
      detail = null;
      batchSelected.clear();
      void loadQueue();
    }, 2500);
  }

  function pollPublish(runId: string) {
    window.clearInterval(publishPollTimer);
    let transientFailures = 0;
    const MAX_TRANSIENT = 5;
    publishPollTimer = window.setInterval(async () => {
      try {
        const st = await getPublishStatus(runId);
        transientFailures = 0;
        if (st.status === "running" || st.status === "queued") {
          renderPublishStatus(
            `Procesando… (proceso ${runId}) — editor → auditoría → imagen → PR. Tarda unos minutos.`,
          );
          return;
        }
        window.clearInterval(publishPollTimer);
        setPublishInFlight(false);
        const batchItems = (st.summary as Record<string, unknown> | undefined)?.items;
        if (st.status === "succeeded" && st.pr_url) {
          renderPublishStatus(
            `Publicado — PR abierto: <a class="text-amber-400 underline" href="${esc(st.pr_url)}" target="_blank" rel="noopener">${esc(st.pr_url)}</a>. Fusiónalo para publicar. Actualizando la cola…`,
          );
          scheduleQueueRefresh();
        } else if (st.status === "succeeded" && renderBatchItems(runId, batchItems)) {
          batchSelected.clear();
          scheduleQueueRefresh();
        } else if (st.status === "succeeded") {
          renderPublishStatus(
            `La refinería terminó sin registrar URL de PR (proceso ${runId}). Revisa el resumen del intento de publicación.`,
          );
        } else if (st.status === "interrupted") {
          renderPublishStatus(
            `Publicación interrumpida (el servidor se reinició, proceso ${runId}).`,
          );
        } else {
          const reason = st.failure_class
            ? `${st.failure_class} — ${st.error ?? "sin detalle"}`
            : (st.error ?? "error desconocido");
          renderPublishStatus(`No publicado (proceso ${runId}): ${esc(reason)}`);
        }
      } catch (e) {
        if (e instanceof Error && e.name === "AuthError") {
          window.clearInterval(publishPollTimer);
          setPublishInFlight(false);
          clearToken();
          showAuthGate();
          return;
        }
        if (e instanceof NetworkError && transientFailures < MAX_TRANSIENT) {
          transientFailures += 1;
          renderPublishStatus(
            `Procesando… (proceso ${runId}) — API fuera de alcance, reintentando (${transientFailures}/${MAX_TRANSIENT})`,
          );
          return;
        }
        window.clearInterval(publishPollTimer);
        setPublishInFlight(false);
        renderPublishStatus(`Falló la consulta de estado: ${esc((e as Error).message)}`);
      }
    }, 3000);
  }

  async function doPublish(opts: { articleId?: number; articleUrl?: string }) {
    if (publishInFlight) {
      showToast("Ya hay una publicación en curso.", "err");
      return;
    }
    setPublishInFlight(true);
    renderPublishStatus("Iniciando proceso…");
    try {
      const started: AdminPublishStarted = await startPublish({
        articleId: opts.articleId,
        articleUrl: opts.articleUrl,
      });
      renderPublishStatus(`${esc(started.detail)} (run ${started.run_id})`);
      pollPublish(started.run_id);
    } catch (e) {
      if (e instanceof Error && e.name === "AuthError") {
        setPublishInFlight(false);
        clearToken();
        showAuthGate();
        return;
      }
      if (e instanceof ConflictError) {
        const existing = e.body as Partial<AdminPublishStarted>;
        if (existing.run_id) {
          renderPublishStatus(
            `Ya hay una publicación en curso (proceso ${existing.run_id}) — observándola.`,
          );
          pollPublish(existing.run_id);
          return;
        }
      }
      setPublishInFlight(false);
      renderPublishStatus(`No se pudo iniciar la publicación: ${esc((e as Error).message)}`);
    }
  }

  publishUrlForm?.addEventListener("submit", (event) => {
    event.preventDefault();
    const url = publishUrlInput?.value.trim();
    if (!url) return;
    void doPublish({ articleUrl: url });
  });

  async function doPublishBatch() {
    const ids = batchIds();
    if (publishInFlight) {
      showToast("Ya hay una publicación en curso.", "err");
      return;
    }
    if (ids.length === 0) {
      showToast("Marca primero de 1 a 5 filas publicables.", "err");
      return;
    }
    setPublishInFlight(true);
    renderPublishStatus(`Iniciando lote de ${ids.length} artículos…`);
    try {
      const started = await startPublishBatch(ids);
      renderPublishStatus(`${esc(started.detail)} (run ${started.run_id})`);
      pollPublish(started.run_id);
    } catch (e) {
      if (e instanceof Error && e.name === "AuthError") {
        setPublishInFlight(false);
        clearToken();
        showAuthGate();
        return;
      }
      if (e instanceof ConflictError) {
        const existing = e.body as Partial<AdminPublishStarted>;
        if (existing.run_id) {
          renderPublishStatus(
            `Ya hay una publicación en curso (proceso ${existing.run_id}) — observándola.`,
          );
          pollPublish(existing.run_id);
          return;
        }
      }
      setPublishInFlight(false);
      renderPublishStatus(`No se pudo iniciar el lote: ${esc((e as Error).message)}`);
    }
  }

  batchBtn?.addEventListener("click", () => void doPublishBatch());

  renderFilters();
  void loadQueue();
</script>
