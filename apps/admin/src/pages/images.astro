---
import AuthGate from '../components/AuthGate.astro';
import AdminLayout from '../layouts/AdminLayout.astro';
---

<AdminLayout title="Imágenes" current="/images">
  <AuthGate>
    <header class="mb-8">
      <h1 class="display-title text-4xl text-paper-100">Cola de imágenes</h1>
      <p class="data-label mt-2">EDITAR BRIEFS · RECURSOS EN ESCENA · DESDE /V1/ADMIN/IMAGES</p>
    </header>
    <div id="summary" class="mb-6 flex flex-wrap gap-3"></div>
    <div id="cards" class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-3"></div>
    <div id="empty" class="hidden py-16 text-center text-sm text-ink-400">Sin briefs en cola.</div>
    <div
      id="toast"
      role="status"
      class="fixed bottom-6 right-6 z-50 hidden max-w-md rounded-lg border border-ink-600 bg-ink-900 px-4 py-3 text-sm shadow-xl"
    >
    </div>
  </AuthGate>
</AdminLayout>

<script>
  import {
    clearToken,
    getImageQueue,
    showAuthGate,
    startPublish,
    updateImageBrief,
    uploadImageBriefAsset,
  } from '../lib/api';
  import { escapeHtml as esc, renderImageCard } from '../lib/imageDesk';

  const cardsEl = document.getElementById('cards');
  const emptyEl = document.getElementById('empty');
  const summaryEl = document.getElementById('summary');
  const toastEl = document.getElementById('toast');

  function showToast(message: string, kind: 'ok' | 'err' = 'ok') {
    if (!toastEl) return;
    toastEl.textContent = message;
    toastEl.className =
      `fixed bottom-6 right-6 z-50 max-w-md rounded-lg border px-4 py-3 text-sm shadow-xl ` +
      (kind === 'ok'
        ? 'border-verdigris-500/50 bg-ink-900 text-verdigris-400'
        : 'border-rose-500/50 bg-ink-900 text-rose-400');
    toastEl.classList.remove('hidden');
    window.setTimeout(() => toastEl?.classList.add('hidden'), 4000);
  }

  async function load() {
    try {
      const { briefs } = await getImageQueue();
      if (emptyEl) emptyEl.classList.toggle('hidden', briefs.length > 0);
      if (summaryEl) {
        summaryEl.innerHTML = `
          <div class="card px-4 py-2.5 font-mono text-xs text-ink-200">en cola <span class="text-amber-400">${briefs.length}</span></div>
        `;
      }
      if (!cardsEl) return;
      cardsEl.innerHTML = briefs.map((b) => renderImageCard(b)).join('');
    } catch (e) {
      if (e instanceof Error && e.name === 'AuthError') {
        clearToken();
        showAuthGate();
        return;
      }
      if (cardsEl) {
        cardsEl.innerHTML = `<div class="card col-span-full px-5 py-10 text-center text-rose-400">Falló: ${esc((e as Error).message)}</div>`;
      }
    }
  }

  function collectFields(card: HTMLElement): Record<string, string> {
    const fields: Record<string, string> = {};
    card
      .querySelectorAll<HTMLInputElement | HTMLSelectElement>(
        'input[data-field], select[data-field]'
      )
      .forEach((input) => {
        const key = input.dataset.field ?? '';
        if (key) fields[key] = input.value;
      });
    return fields;
  }

  cardsEl?.addEventListener('click', async (event) => {
    const target = (event.target as HTMLElement).closest('button');
    if (!target) return;
    const card = target.closest<HTMLElement>('[data-slug]');

    if (target.dataset.copy) {
      const prompt = card?.querySelector<HTMLElement>('pre[data-prompt]')?.textContent ?? '';
      if (!prompt) {
        showToast('El brief no tiene prompt guardado', 'err');
        return;
      }
      try {
        await navigator.clipboard.writeText(prompt);
        showToast('Prompt copiado al portapapeles');
      } catch {
        showToast('No se pudo copiar; selecciona el texto del prompt manualmente.', 'err');
      }
      return;
    }

    if (target.dataset.publish) {
      const articleId = Number(target.dataset.publish);
      if (!Number.isFinite(articleId) || articleId <= 0) {
        showToast('El brief no tiene un id de artículo válido', 'err');
        return;
      }
      target.toggleAttribute('disabled', true);
      try {
        const started = await startPublish({ articleId });
        showToast(`Publicación iniciada (run ${started.run_id})`);
        await load();
      } catch (e) {
        if (e instanceof Error && e.name === 'AuthError') {
          clearToken();
          showAuthGate();
          return;
        }
        const reason = e instanceof Error && e.message ? ` — ${e.message}` : '';
        showToast(`No se pudo iniciar la publicación${reason}`, 'err');
      } finally {
        target.toggleAttribute('disabled', false);
      }
      return;
    }

    if (!target.dataset.save) return;
    const slug = target.dataset.save;
    if (!card) return;
    try {
      await updateImageBrief(slug, collectFields(card));
      showToast(`Brief ${slug} actualizado`);
    } catch (e) {
      if (e instanceof Error && e.name === 'AuthError') {
        clearToken();
        showAuthGate();
        return;
      }
      showToast('No se pudo guardar: ' + (e as Error).message, 'err');
    }
  });

  cardsEl?.addEventListener('change', async (event) => {
    const input = event.target as HTMLInputElement;
    if (!input.files?.length) return;
    const slug = input.dataset.upload ?? '';
    const card = input.closest<HTMLElement>('[data-slug]');
    if (!card) return;
    try {
      await uploadImageBriefAsset(slug, input.files[0], collectFields(card));
      showToast(`Recurso añadido a ${slug}`);
      await load();
    } catch (e) {
      if (e instanceof Error && e.name === 'AuthError') {
        clearToken();
        showAuthGate();
        return;
      }
      showToast('No se pudo subir: ' + (e as Error).message, 'err');
    }
  });

  void load();
  window.addEventListener('auth:ready', () => void load());
</script>
