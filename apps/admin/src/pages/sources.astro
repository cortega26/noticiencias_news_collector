---
import AuthGate from "../components/AuthGate.astro";
import AdminLayout from "../layouts/AdminLayout.astro";
---

<AdminLayout title="Sources" current="/sources">
  <AuthGate>
    <header class="mb-8 flex items-end justify-between">
      <div>
        <h1 class="display-title text-4xl text-paper-100">Source manager</h1>
        <p class="data-label mt-2">CIRCUIT STATE + ACTIVE FLAG · ADD/EDIT/DELETE</p>
      </div>
      <div class="flex items-center gap-3">
        <button id="add-source" class="btn-primary" type="button">+ Add source</button>
        <button id="refresh" class="btn-ghost" type="button">Refresh</button>
      </div>
    </header>

    <div id="editor" class="card mb-6 hidden p-5">
      <div class="mb-4 flex items-center justify-between">
        <div class="data-label" id="editor-title">ADD SOURCE</div>
        <button id="editor-close" class="btn-ghost !px-2 !py-0.5 text-xs" type="button">✕</button>
      </div>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <label class="block">
          <span class="data-label block mb-1">ID (snake_case)</span>
          <input id="f-id" class="w-full rounded border border-ink-700 bg-ink-900 px-2.5 py-1.5 font-mono text-xs text-ink-100 focus:border-amber-500 outline-none" />
        </label>
        <label class="block">
          <span class="data-label block mb-1">NAME *</span>
          <input id="f-name" class="w-full rounded border border-ink-700 bg-ink-900 px-2.5 py-1.5 font-mono text-xs text-ink-100 focus:border-amber-500 outline-none" />
        </label>
        <label class="block">
          <span class="data-label block mb-1">URL *</span>
          <input id="f-url" class="w-full rounded border border-ink-700 bg-ink-900 px-2.5 py-1.5 font-mono text-xs text-ink-100 focus:border-amber-500 outline-none" />
        </label>
        <label class="block">
          <span class="data-label block mb-1">CREDIBILITY (0-1)</span>
          <input id="f-cred" type="number" step="0.05" min="0" max="1" value="0.8" class="w-full rounded border border-ink-700 bg-ink-900 px-2.5 py-1.5 font-mono text-xs text-ink-100 focus:border-amber-500 outline-none" />
        </label>
        <label class="block">
          <span class="data-label block mb-1">CATEGORY</span>
          <select id="f-cat" class="w-full rounded border border-ink-700 bg-ink-900 px-2.5 py-1.5 font-mono text-xs text-ink-100 focus:border-amber-500 outline-none">
            <option>technology</option><option selected>science</option><option>medicine</option>
            <option>space</option><option>biology</option><option>multidisciplinary</option>
            <option>popular_science</option><option>artificial_intelligence</option>
          </select>
        </label>
        <label class="block">
          <span class="data-label block mb-1">FREQUENCY</span>
          <select id="f-freq" class="w-full rounded border border-ink-700 bg-ink-900 px-2.5 py-1.5 font-mono text-xs text-ink-100 focus:border-amber-500 outline-none">
            <option selected>daily</option><option>weekly</option><option>hourly</option><option>multiple_daily</option>
          </select>
        </label>
        <label class="block">
          <span class="data-label block mb-1">GROUP</span>
          <select id="f-group" class="w-full rounded border border-ink-700 bg-ink-900 px-2.5 py-1.5 font-mono text-xs text-ink-100 focus:border-amber-500 outline-none">
            <option>ELITE_JOURNALS</option><option>SCIENCE_MEDIA</option>
            <option>INSTITUTIONAL_SOURCES</option><option>AI_LABS</option><option selected>CUSTOM</option>
          </select>
        </label>
      </div>
      <p id="editor-error" class="mt-3 hidden text-sm text-rose-400"></p>
      <div class="mt-4 flex justify-end gap-2">
        <button id="editor-save" class="btn-primary" type="button">Save source</button>
      </div>
    </div>

    <div id="summary" class="mb-6 flex flex-wrap gap-3"></div>
    <div class="card overflow-x-auto">
      <table class="w-full min-w-[760px] text-left">
        <thead>
          <tr class="border-b border-ink-700">
            <th class="data-label px-5 py-3">SOURCE</th>
            <th class="data-label px-5 py-3">MODE</th>
            <th class="data-label px-5 py-3">CIRCUIT</th>
            <th class="data-label px-5 py-3">ACTIVE</th>
            <th class="data-label px-5 py-3 text-right">ACTIONS</th>
          </tr>
        </thead>
        <tbody id="rows"></tbody>
      </table>
      <div id="empty" class="hidden py-16 text-center text-sm text-ink-400">
        No sources loaded.
      </div>
    </div>
    <div id="toast" class="fixed bottom-6 right-6 z-50 hidden max-w-sm rounded-lg border border-ink-600 bg-ink-900 px-4 py-3 text-sm shadow-xl"></div>
  </AuthGate>
</AdminLayout>

<script>
  import {
    clearToken,
    deleteSource,
    listSources,
    resetSourceCircuit,
    showAuthGate,
    toggleSource,
    upsertSource,
  } from "../lib/api";
  import type { AdminSourceListItem } from "../lib/types";

  const rowsEl = document.getElementById("rows");
  const emptyEl = document.getElementById("empty");
  const summaryEl = document.getElementById("summary");
  const toastEl = document.getElementById("toast");
  const editorEl = document.getElementById("editor");
  const editorTitleEl = document.getElementById("editor-title");
  const editorErrorEl = document.getElementById("editor-error");

  function esc(s: unknown): string {
    if (s == null) return "";
    const div = document.createElement("div");
    div.textContent = String(s);
    return div.innerHTML;
  }

  function showToast(message: string, kind: "ok" | "err" = "ok") {
    if (!toastEl) return;
    toastEl.textContent = message;
    toastEl.className =
      `fixed bottom-6 right-6 z-50 max-w-sm rounded-lg border px-4 py-3 text-sm shadow-xl ` +
      (kind === "ok"
        ? "border-verdigris-500/50 bg-ink-900 text-verdigris-400"
        : "border-rose-500/50 bg-ink-900 text-rose-400");
    toastEl.classList.remove("hidden");
    window.setTimeout(() => toastEl?.classList.add("hidden"), 2600);
  }

  function circuitLabel(circuit: Record<string, unknown> | null): string {
    if (!circuit) return "no row";
    const status = String(circuit.status ?? "ACTIVE");
    const failures = Number(circuit.consecutive_failures ?? 0);
    if (status === "COOLDOWN") {
      return `COOLDOWN (${failures} fail)`;
    }
    return `${status}${failures > 0 ? ` (${failures} fail)` : ""}`;
  }

  let sources: AdminSourceListItem[] = [];

  function openEditor(source?: AdminSourceListItem) {
    if (!editorEl) return;
    editorEl.classList.remove("hidden");
    const id = document.getElementById("f-id") as HTMLInputElement;
    const name = document.getElementById("f-name") as HTMLInputElement;
    const url = document.getElementById("f-url") as HTMLInputElement;
    const cred = document.getElementById("f-cred") as HTMLInputElement;
    const cat = document.getElementById("f-cat") as HTMLSelectElement;
    const freq = document.getElementById("f-freq") as HTMLSelectElement;
    const group = document.getElementById("f-group") as HTMLSelectElement;
    if (editorTitleEl) editorTitleEl.textContent = source ? `EDIT SOURCE · ${source.source_id}` : "ADD SOURCE";
    if (editorErrorEl) editorErrorEl.classList.add("hidden");
    id.value = source?.source_id ?? "";
    id.disabled = !!source;
    name.value = source?.name ?? "";
    url.value = source?.url ?? "";
    cred.value = source?.circuit?.credibility_score != null ? String(source.circuit.credibility_score) : "0.8";
    cat.value = source?.category ?? "science";
    freq.value = "daily";
    group.value = "CUSTOM";
    (document.getElementById("f-id") as HTMLInputElement).focus();
  }

  function closeEditor() {
    editorEl?.classList.add("hidden");
  }

  async function saveEditor() {
    const id = (document.getElementById("f-id") as HTMLInputElement).value.trim();
    const name = (document.getElementById("f-name") as HTMLInputElement).value.trim();
    const url = (document.getElementById("f-url") as HTMLInputElement).value.trim();
    const cred = Number((document.getElementById("f-cred") as HTMLInputElement).value);
    const cat = (document.getElementById("f-cat") as HTMLSelectElement).value;
    const freq = (document.getElementById("f-freq") as HTMLSelectElement).value;
    const group = (document.getElementById("f-group") as HTMLSelectElement).value;
    if (!id || !name || !url) {
      if (editorErrorEl) {
        editorErrorEl.textContent = "ID, name and URL are required.";
        editorErrorEl.classList.remove("hidden");
      }
      return;
    }
    try {
      const result = await upsertSource({
        source_id: id,
        name,
        url,
        credibility_score: Number.isFinite(cred) ? cred : 0.8,
        category: cat,
        update_frequency: freq,
        group,
      });
      showToast(result.detail);
      closeEditor();
      await load();
    } catch (e) {
      if (e instanceof Error && e.name === "AuthError") {
        clearToken();
        showAuthGate();
        return;
      }
      if (editorErrorEl) {
        editorErrorEl.textContent = "Save failed: " + (e as Error).message;
        editorErrorEl.classList.remove("hidden");
      }
    }
  }

  async function load() {
    try {
      const { sources: list } = await listSources();
      sources = list;
      if (emptyEl) emptyEl.classList.toggle("hidden", sources.length > 0);
      const active = sources.filter((s) => s.is_active).length;
      const cooldown = sources.filter(
        (s) => (s.circuit?.status as string) === "COOLDOWN",
      ).length;
      if (summaryEl) {
        summaryEl.innerHTML = `
          <div class="card px-4 py-2.5 font-mono text-xs text-ink-200">total <span class="text-amber-400">${sources.length}</span></div>
          <div class="card px-4 py-2.5 font-mono text-xs text-verdigris-400">active ${active}</div>
          <div class="card px-4 py-2.5 font-mono text-xs text-rose-400">cooldown ${cooldown}</div>
        `;
      }
      if (!rowsEl) return;
      rowsEl.innerHTML = sources
        .map((s) => {
          const inCooldown = (s.circuit?.status as string) === "COOLDOWN";
          return `
          <tr class="border-b border-ink-800/70 transition-colors hover:bg-ink-800/40">
            <td class="px-5 py-3">
              <div class="text-sm font-medium text-ink-100">${esc(s.name ?? s.source_id)}</div>
              <div class="font-mono text-[11px] text-ink-400">${esc(s.source_id)}</div>
            </td>
            <td class="px-5 py-3 font-mono text-[11px] text-ink-300">${esc(s.content_mode ?? "—")}</td>
            <td class="px-5 py-3">
              <span class="font-mono text-[11px] ${inCooldown ? "text-rose-400" : "text-verdigris-400"}">${esc(circuitLabel(s.circuit))}</span>
            </td>
            <td class="px-5 py-3">
              <span class="font-mono text-[11px] ${s.is_active ? "text-verdigris-400" : "text-ink-400"}">${s.is_active ? "ON" : "OFF"}</span>
            </td>
            <td class="px-5 py-3">
              <div class="flex justify-end gap-2">
                <button class="btn-ghost !px-2.5 !py-1 text-xs" data-edit="${esc(s.source_id)}" type="button">Edit</button>
                <button class="btn-ghost !px-2.5 !py-1 text-xs" data-toggle="${esc(s.source_id)}" data-active="${s.is_active ? "1" : "0"}" type="button">
                  ${s.is_active ? "Deactivate" : "Activate"}
                </button>
                ${inCooldown ? `<button class="btn-ghost !px-2.5 !py-1 text-xs" data-reset="${esc(s.source_id)}" type="button">Reset circuit</button>` : ""}
                <button class="btn-danger !px-2.5 !py-1 text-xs" data-delete="${esc(s.source_id)}" type="button">Delete</button>
              </div>
            </td>
          </tr>`;
        })
        .join("");
    } catch (e) {
      if (e instanceof Error && e.name === "AuthError") {
        clearToken();
        showAuthGate();
        return;
      }
      showToast("Failed to load sources: " + (e as Error).message, "err");
    }
  }

  rowsEl?.addEventListener("click", async (event) => {
    const target = (event.target as HTMLElement).closest("button");
    if (!target) return;
    const sourceId = target.dataset.edit ?? target.dataset.toggle ?? target.dataset.reset ?? target.dataset.delete;
    if (!sourceId) return;
    if (target.dataset.edit) {
      const src = sources.find((s) => s.source_id === sourceId);
      openEditor(src);
      return;
    }
    try {
      if (target.dataset.toggle) {
        const active = target.dataset.active === "1" ? false : true;
        const result = await toggleSource(sourceId, active);
        showToast(result.detail);
      } else if (target.dataset.delete) {
        if (!window.confirm(`Delete source "${sourceId}"? This removes it from sources.yaml and the DB.`)) {
          return;
        }
        const result = await deleteSource(sourceId);
        showToast(result.detail);
      } else {
        const result = await resetSourceCircuit(sourceId);
        showToast(result.detail);
      }
      await load();
    } catch (e) {
      if (e instanceof Error && e.name === "AuthError") {
        clearToken();
        showAuthGate();
        return;
      }
      showToast("Action failed: " + (e as Error).message, "err");
    }
  });

  document.getElementById("add-source")?.addEventListener("click", () => openEditor());
  document.getElementById("editor-close")?.addEventListener("click", closeEditor);
  document.getElementById("editor-save")?.addEventListener("click", () => void saveEditor());
  document.getElementById("refresh")?.addEventListener("click", () => void load());
  void load();
  window.addEventListener("auth:ready", () => void load());
</script>
