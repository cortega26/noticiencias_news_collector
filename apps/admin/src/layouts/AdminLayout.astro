---
import "../styles/global.css";

interface Props {
  title: string;
  current?: string;
}

const { title, current } = Astro.props;

const NAV = [
  { href: "/triage", label: "Triage", glyph: "▸" },
  { href: "/sources", label: "Sources", glyph: "◫" },
  { href: "/content", label: "Content", glyph: "▤" },
  { href: "/images", label: "Images", glyph: "◱" },
  { href: "/analytics", label: "Analytics", glyph: "◔" },
  { href: "/prompts", label: "Prompts", glyph: "✎" },
  { href: "/config", label: "Config", glyph: "⚙" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Noticiencias Refinery</title>
  </head>
  <body>
    <div class="flex min-h-screen">
      <aside
        class="fixed inset-y-0 left-0 z-40 flex w-56 flex-col border-r border-ink-800 bg-ink-900/80 px-4 py-6 backdrop-blur"
      >
        <a href="/triage" class="mb-8 block px-2">
          <div class="display-title text-lg leading-tight text-paper-100">
            Noticiencias
          </div>
          <div class="data-label mt-1 text-amber-400/90">REFINERY · ADMIN</div>
        </a>

        <nav class="flex flex-1 flex-col gap-1">
          {
            NAV.map((item) => (
              <a
                href={item.href}
                class:list={[
                  "group flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium transition-colors",
                  current === item.href
                    ? "bg-ink-800 text-amber-400"
                    : "text-ink-300 hover:bg-ink-850 hover:text-ink-100",
                ]}
              >
                <span
                  class:list={[
                    "font-mono text-sm",
                    current === item.href
                      ? "text-amber-400"
                      : "text-ink-600 group-hover:text-ink-400",
                  ]}
                >
                  {item.glyph}
                </span>
                {item.label}
              </a>
            ))
          }
        </nav>

        <div class="border-t border-ink-800 px-3 pt-4">
          <div class="data-label">Serving API</div>
          <div class="mt-1.5 font-mono text-[11px] text-ink-400">
            /v1/admin/* · Bearer
          </div>
        </div>
      </aside>

      <main class="ml-56 min-w-0 flex-1 px-8 py-8">
        <slot />
      </main>
    </div>
  </body>
</html>
