# Local dev config for the Refinery admin GUI (gitignored). Optional.
#
# For local work you normally need NOTHING here: `astro dev` proxies /v1/* to
# the serving API (default http://localhost:8000, see astro.config.mjs), and
# `make admin` starts both processes together.
#
# Set PUBLIC_ADMIN_API_BASE only for a built/previewed app (the proxy does not
# apply there) or when the API is on another host. An absolute base overrides
# the dev proxy.
# PUBLIC_ADMIN_API_BASE=http://localhost:8000
#
# Set PUBLIC_ADMIN_API_KEY to the backend's ADMIN_API_KEY to skip the login
# gate on a production build. Not needed for `astro dev` (gate is bypassed and
# the backend fail-opens in the "development" environment).
# PUBLIC_ADMIN_API_KEY=
