# Refinery-only environment (stored in apps/refinery/.env)
GITHUB_TOKEN=your_github_token_here
SOURCE_REPO_URL=https://github.com/cortega26/noticiencias_news_collector.git
TARGET_REPO_URL=https://github.com/cortega26/noticiencias.git
OLLAMA_API_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3.3
REFINERY_UI_TOKEN=replace_with_strong_token
REFINERY_UI_UNSAFE_ALLOW=0
NEWS_COLLECTOR_PATH=../..
